# Copy to .env.local and fill in real values. Never commit .env.local.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# Flashpoint bearer token (event-issued). Only needed for RESEARCH_MODE=live.
FLASHPOINT_TOKEN=
# live | captured | fixture
RESEARCH_MODE=captured
# Set to "fixtures" to run the whole app without any API keys.
DEMO_MODE=
